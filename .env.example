# Copy to backend/.env and fill in.

# Spotify app credentials: https://developer.spotify.com/dashboard
# Add this exact Redirect URI to your Spotify app settings (loopback IP, not "localhost"):

SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# Anthropic credentials: EITHER set an API key (https://console.anthropic.com)
# OR leave this blank and run `ant auth login` (brew install ant); the SDK will
# use and auto-refresh that profile's credentials.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Run on the bundled sample dataset (no Spotify login needed)
DEMO_MODE=false

# Hours between automatic Spotify syncs
SYNC_INTERVAL_HOURS=24

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://127.0.0.1:5173
